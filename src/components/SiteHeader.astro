---
interface Props { eyebrow: string; title: string; description: string; titleId?: string; }
const { eyebrow, title, description, titleId } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class="module-hero theme-lake">
  <div class="shell">
    <nav class="module-nav" aria-label="页面导航"><a class="back-link" href={base}>← Sami Writing Desk</a></nav>
    <div class="module-hero__grid">
      <div class="field-tab">
        <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M9 3.5v17M12 8h4M12 12h4M12 16h3"/><path d="M4 7h2M4 11h2M4 15h2"/></svg>
        <span>{eyebrow}</span>
      </div>
      <div class="module-hero__copy">
        <p class="eyebrow">{eyebrow}</p>
        <h1 id={titleId}>{title}</h1>
        <p>{description}</p>
      </div>
    </div>
  </div>
</header>
