---
import BaseLayout from '../layouts/BaseLayout.astro';
import { novelBooks } from '../config/books';
import { novelViews } from '../lib/views/registry.ts';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const spine = (title: string) => (title.match(/\b[A-Z]/g)?.join('') ?? title).slice(0, 3);
---
<BaseLayout title="小离总周报 · Sami Writing Desk" description="私人小说知识库：从事件、人物和时间线回到原文。" pageClass="home-page">
  <header class="site">
    <a class="logo" href={base}><i aria-hidden="true">离</i><b>小离总周报</b></a>
    <span class="sp"></span>
    <span class="who" id="home-who"></span>
    <button type="button" class="btn" id="home-sign-in" hidden>登录</button>
    <div class="menu-wrap">
      <button type="button" class="avatar" id="home-account" aria-haspopup="true" aria-expanded="false" hidden></button>
      <div class="menu" id="home-account-menu" hidden>
        <div class="who"></div>
        <button type="button" id="home-sign-out">退出登录</button>
      </div>
    </div>
  </header>
  <main id="main-content" class="wrap">
    <section class="greet">
      <h1 id="home-greet">小离总周报</h1>
      <p id="home-lead">私人小说知识库：从事件、人物和时间线回到原文。登录家庭 Google 账号后阅读。</p>
    </section>
    <div class="sec">
      <h2>书架</h2><span class="n">{novelBooks.length} 本</span><span class="sp"></span>
      <input type="search" id="home-filter" placeholder="找书名…" aria-label="找书名" autocomplete="off" />
    </div>
    <div class="shelf" id="home-shelf">
      {novelBooks.map((book) => (
        <article class="bookcard" data-book={book.slug} data-title={book.title}>
          <a class="cover" href={withBase(`/book/?book=${book.slug}`)}>
            <span class="spine" aria-hidden="true">{spine(book.title)}</span>
            <div class="cover-text">
              <h3>{book.title}</h3>
              <p class="scope" data-scope>私人资料 · 登录后可读</p>
              <div class="stats" data-stats></div>
            </div>
          </a>
          <div class="acts">
            {novelViews.filter(view => view.id !== 'outline').map((view) => 'soon' in view
              ? <button type="button" class="soon" data-soon={view.soon}>{view.label}</button>
              : <a class={view.id === 'reader' ? 'primary' : ''} href={withBase(`/book/?book=${book.slug}${view.id === 'reader' ? '' : `&view=${view.id}`}`)}>{view.label}</a>)}
          </div>
        </article>
      ))}
      <div class="ghost"><b>下一本书</b>书稿同步进来后会出现在这里</div>
    </div>
    <p class="foot">公开页面只有登录和阅读器外壳；小说内容只在家庭成员登录后从私有数据库读取。</p>
  </main>
  <script>
    import { mountHome } from '../lib/home.ts';
    mountHome({
      apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
      authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
      projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
      databaseURL: import.meta.env.PUBLIC_FIREBASE_DATABASE_URL,
      storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
      messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
      appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
      householdId: import.meta.env.PUBLIC_FAMILY_HOUSEHOLD_ID,
    });
  </script>
</BaseLayout>
